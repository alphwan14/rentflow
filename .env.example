# RentFlow v2 — copy to .env.local and fill in. Never commit real values.

# ── Web app (Next.js on Vercel) ─────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Public URL of the app (used in email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only (worker on Render, scripts). NEVER expose to the browser. ──
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Direct Postgres connection, used by the job-queue worker (phase 4)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── SMS: Africa's Talking (phase 4) ─────────────────────────────────────────
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ── Live payment notifications (phase 4) ────────────────────────────────────
# Safaricom Daraja C2B
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Shared secret in the confirmation/validation callback URLs
DARAJA_CALLBACK_TOKEN=
# KCB Buni IPN
KCB_BUNI_CLIENT_ID=
KCB_BUNI_CLIENT_SECRET=
KCB_BUNI_IPN_TOKEN=

# ── Notebook photo import (AI vision, later) ────────────────────────────────
ANTHROPIC_API_KEY=
